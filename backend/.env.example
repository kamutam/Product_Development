# ==============================================================================
# BRIHASPATHI TECHNOLOGIES - PRODUCT INTELLIGENCE BACKEND CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL 15+ with pgvector support)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_intelligence?schema=public"

# Authentication & JWT Secrets (Rotate in production)
JWT_SECRET="brihaspathi-production-jwt-super-secret-key-change-in-prod-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="brihaspathi-production-refresh-token-super-secret-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration
# Supported providers: "gemini" | "openai" | "mock"
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=text-embedding-004

# Redis Configuration (For Caching & BullMQ Background Job Queue)
REDIS_URL="redis://localhost:6379"
ENABLE_BACKGROUND_JOBS=false

# File Storage Provider ("local" | "s3")
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=brihaspathi-product-docs
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
